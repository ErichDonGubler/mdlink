mod github;

pub fn main(args) {
	match args {
		mdlink::ScriptArgs { url } => {
			let rendered = match url.scheme() {
				"http" => handle_http_link(url),
				"https" => handle_http_link(url),
				_ => None,
			};

			match rendered {
				Some(rendered) => {
					// TODO: report bug, can't return template literal directly
					let msg = `[${rendered}](${url})`;
					return msg;
				}
			}

			`<${url}>`
		}
	}
}

pub fn handle_http_link(url) {
	url.host().and_then(|host| match host {
		"github.com" => github::prettify(url, "blarg"),
		_ => None
	})
}
